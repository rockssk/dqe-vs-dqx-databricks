  {"rule_id": "C2", "table": "contacts",   "name": "C2_valid_email",              "action": "drop", "dimension": "Validity",     "constraint": "coalesce(email RLIKE '^[^@\\\\s]+@[^@\\\\s]+\\\\.[a-z]{2,}$', false)"},
  {"rule_id": "C4", "table": "contacts",   "name": "C4_vendor_contact_has_advisor_crd",   "action": "drop", "dimension": "Completeness", "constraint": "source <> 'VENDOR' OR advisor_crd IS NOT NULL"},
  {"rule_id": "C5", "table": "contacts",   "name": "C5_company_guid_not_null",    "action": "drop", "dimension": "Completeness", "constraint": "company_guid IS NOT NULL"},
  {"rule_id": "C6", "table": "contacts",   "name": "C6_third_party_guid_format",  "action": "drop", "dimension": "Validity",     "constraint": "coalesce(third_party_identifier_guid RLIKE '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', false)"},

  {"rule_id": "R0", "table": "activities", "name": "R0_no_rescued_data",          "action": "drop", "dimension": "Validity",     "constraint": "_rescued_data IS NULL"},
  {"rule_id": "A2", "table": "activities", "name": "A2_detail_guid_not_null",     "action": "drop", "dimension": "Completeness", "constraint": "sales_activity_detail_guid IS NOT NULL"},
  {"rule_id": "A3", "table": "activities", "name": "A3_party_guid_not_null",      "action": "drop", "dimension": "Completeness", "constraint": "sales_activity_party_guid IS NOT NULL"},
  {"rule_id": "A4", "table": "activities", "name": "A4_valid_activity_date",      "action": "drop", "dimension": "Validity",     "constraint": "try_to_timestamp(sales_activity_date, 'yyyy-MM-dd HH:mm:ss') IS NOT NULL"},
  {"rule_id": "A5", "table": "activities", "name": "A5_meeting_flag_accuracy",    "action": "warn", "dimension": "Accuracy",     "constraint": "activity_type <> 'appointment' OR mtg_flag = 'Y'"},
  {"rule_id": "A6", "table": "activities", "name": "A6_contact_exists",           "action": "drop", "dimension": "Consistency",  "constraint": "_contact_exists"},

